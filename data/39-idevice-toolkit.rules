# idevice-toolkit: let logged-in users access Apple devices in Recovery/DFU mode
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="122[0-9a-f]", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="128[0-3]", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="1338", MODE="0666", TAG+="uaccess"
